<?xml version="1.0" ?>
<robot name="megadroid_mvs">
  <link name="pelvis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.3 0.15"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>
  <link name="torso">
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.25 0.4"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>
  <joint name="pelvis_to_torso" type="fixed">
    <parent link="pelvis"/>
    <child link="torso"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="left_hip"/>
  <joint name="left_hip_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="left_hip"/>
    <origin xyz="0 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5235983333333333" upper="1.9198605555555557" effort="100" velocity="1.0"/>
  </joint>
  <link name="left_thigh">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
  </link>
  <joint name="left_thigh_joint" type="fixed">
    <parent link="left_hip"/>
    <child link="left_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="left_knee"/>
  <joint name="left_knee_joint" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_knee"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.443458888888889" effort="100" velocity="1.0"/>
  </joint>
  <link name="left_shin">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
  </link>
  <joint name="left_shin_joint" type="fixed">
    <parent link="left_knee"/>
    <child link="left_shin"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="left_foot">
    <visual>
      <origin xyz="0.05 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="left_foot_joint" type="fixed">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.38" rpy="0 0 0"/>
  </joint>
  <link name="right_hip"/>
  <joint name="right_hip_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="right_hip"/>
    <origin xyz="0 -0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5235983333333333" upper="1.9198605555555557" effort="100" velocity="1.0"/>
  </joint>
  <link name="right_thigh">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
  </link>
  <joint name="right_thigh_joint" type="fixed">
    <parent link="right_hip"/>
    <child link="right_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="right_knee"/>
  <joint name="right_knee_joint" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_knee"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.443458888888889" effort="100" velocity="1.0"/>
  </joint>
  <link name="right_shin">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
  </link>
  <joint name="right_shin_joint" type="fixed">
    <parent link="right_knee"/>
    <child link="right_shin"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="right_foot">
    <visual>
      <origin xyz="0.05 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="right_foot_joint" type="fixed">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.38" rpy="0 0 0"/>
  </joint>
</robot>
